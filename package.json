{
  "name": "amal-os",
  "version": "1.0.0",
  "private": true,
  "description": "AMAL OS V1 - Muslim Life Intelligence Platform. From Niyyah to Amal.",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "tsx --tsconfig services/api/tsconfig.json scripts/verify-full-production-loop.ts",
    "test:turbo": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:benchmark": "turbo run test:benchmark",
    "test:redteam": "turbo run test:redteam",
    "test:v01": "tsx scripts/test-v01-e2e.ts",
    "test:v05": "tsx --tsconfig services/api/tsconfig.json scripts/test-v05-e2e.ts",
    "test:v08": "tsx --tsconfig services/api/tsconfig.json scripts/test-v08-e2e.ts",
    "test:v10": "tsx --tsconfig services/api/tsconfig.json scripts/test-v10-e2e.ts",
    "test:v15": "tsx --tsconfig services/api/tsconfig.json scripts/test-v15-e2e.ts",
    "test:v15:redteam": "tsx --tsconfig services/api/tsconfig.json scripts/test-v15-redteam.ts",
    "test:v20": "tsx --tsconfig services/api/tsconfig.json scripts/test-v20-e2e.ts",
    "test:v20:redteam": "tsx --tsconfig services/api/tsconfig.json scripts/test-v20-redteam.ts",
    "test:v30": "tsx --tsconfig services/api/tsconfig.json scripts/test-v30-e2e.ts",
    "test:v30:redteam": "tsx --tsconfig services/api/tsconfig.json scripts/test-v30-redteam.ts",
    "test:neutrality": "tsx --tsconfig services/api/tsconfig.json scripts/test-madhhab-neutrality.ts",
    "test:universal": "tsx --tsconfig services/api/tsconfig.json scripts/test-universal-knowledge.ts",
    "test:catalogue": "tsx --tsconfig services/api/tsconfig.json scripts/test-source-catalogue.ts",
    "test:ingestion": "tsx --tsconfig services/api/tsconfig.json scripts/test-scholarly-ingestion.ts",
    "test:multilingual": "tsx --tsconfig services/api/tsconfig.json scripts/test-multilingual-architecture.ts",
    "test:multilingual-engine": "tsx --tsconfig services/api/tsconfig.json scripts/test-multilingual-knowledge-engine.ts",
    "test:legacy": "tsx --tsconfig services/api/tsconfig.json scripts/test-legacy-continuity-os.ts",
    "test:community": "tsx --tsconfig services/api/tsconfig.json scripts/test-community-ummah-os.ts",
    "test:scholar-os": "tsx --tsconfig services/api/tsconfig.json scripts/test-scholar-governance-os.ts",
    "test:spiritual-heritage": "tsx --tsconfig services/api/tsconfig.json scripts/test-spiritual-heritage-os.ts",
    "test:knowledge-factory": "tsx --tsconfig services/api/tsconfig.json scripts/test-knowledge-production-factory.ts",
    "test:acquisition-program": "tsx --tsconfig services/api/tsconfig.json scripts/test-knowledge-acquisition-program.ts",
    "test:master-catalogue": "tsx --tsconfig services/api/tsconfig.json scripts/test-universal-master-catalogue.ts",
    "test:atlas": "tsx --tsconfig services/api/tsconfig.json scripts/test-global-heritage-atlas.ts",
    "test:trust-center": "tsx --tsconfig services/api/tsconfig.json scripts/test-trust-methodology-center.ts",
    "test:sirah": "tsx --tsconfig services/api/tsconfig.json scripts/test-sirah-shamail.ts",
    "test:sirah-benchmark": "tsx --tsconfig services/api/tsconfig.json scripts/run-sirah-benchmarks.ts",
    "test:security": "tsx --tsconfig services/api/tsconfig.json scripts/security-pen-test.ts",
    "test:load": "tsx --tsconfig services/api/tsconfig.json scripts/load-test-simulation.ts",
    "test:dr": "tsx --tsconfig services/api/tsconfig.json scripts/dr-drill-simulation.ts",
    "test:scholar": "tsx --tsconfig services/api/tsconfig.json scripts/test-scholar-workflow.ts",
    "test:knowledge": "tsx scripts/knowledge-audit.ts",
    "test:scholar-alpha": "tsx --tsconfig services/api/tsconfig.json scripts/run-scholar-alpha.ts",
    "test:ai": "tsx --tsconfig services/api/tsconfig.json scripts/test-v05-e2e.ts",
    "test:safety": "tsx --tsconfig services/api/tsconfig.json scripts/security-pen-test.ts",
    "test:e2e": "tsx --tsconfig services/api/tsconfig.json scripts/test-v10-e2e.ts",
    "audit:amal": "tsx --tsconfig services/api/tsconfig.json scripts/audit-amal.ts",
    "test:production-readiness": "tsx --tsconfig services/api/tsconfig.json scripts/verify-full-production-loop.ts",
    "test:ecosystem": "tsx --tsconfig services/api/tsconfig.json scripts/test-new-ecosystem-features.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @amal/database run migrate",
    "db:seed": "pnpm --filter @amal/database run seed",
    "db:reset": "pnpm --filter @amal/database run reset",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
