{
  "name": "amal-os",
  "version": "1.0.0",
  "private": true,
  "description": "AMAL OS V1 - Muslim Life Intelligence Platform. From Niyyah to Amal.",
  "author": "Dr. Irfan Ashraf (Founder & Chief Architect)",
  "company": "Qsura India Pvt Ltd",
  "copyright": "© 2026 Qsura India Pvt Ltd. All rights reserved.",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/serve-railway.mjs",
    "start:web": "SERVICE=web node scripts/serve-railway.mjs",
    "start:api": "SERVICE=api node scripts/serve-railway.mjs",
    "build": "turbo run build",
    "build:web": "pnpm --filter @amal/app-web... run build",
    "build:api": "pnpm --filter @amal/service-api... run build",
    "test": "tsx --tsconfig services/api/tsconfig.json scripts/verify-full-production-loop.ts",
    "test:all": "python3 test/run-all-tests.py",
    "test:turbo": "turbo run test",
    "test:unit": "tsx test/unit/amal-score.test.ts && tsx test/unit/family-firewall.test.ts && tsx test/unit/fatwa-firewall.test.ts && tsx test/unit/scholar-governance.test.ts && tsx test/unit/mobile-screens.test.ts",
    "test:benchmark": "python3 test/test-quran-wisdom-standards.py",
    "test:security": "python3 test/security-penetration-suite.py",
    "test:auth": "python3 test/test-auth-security.py",
    "test:persistence": "python3 test/test-persistence-snapshot.py",
    "test:e2e": "tsx --tsconfig services/api/tsconfig.json test/e2e/test-v10-e2e.ts",
    "audit:amal": "tsx --tsconfig services/api/tsconfig.json scripts/audit-amal.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @amal/database run migrate",
    "db:seed": "pnpm --filter @amal/database run seed",
    "db:reset": "pnpm --filter @amal/database run reset",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
