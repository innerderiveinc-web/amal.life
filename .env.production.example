# ==============================================================================
# AMAL OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=amal_admin
POSTGRES_PASSWORD=generate_strong_64_char_password_here
POSTGRES_DB=amal_prod_db
DATABASE_URL=postgresql://amal_admin:generate_strong_64_char_password_here@postgres:5432/amal_prod_db?schema=public

# High-Performance In-Memory Cache & Message Queue
REDIS_PASSWORD=generate_strong_redis_auth_token_here
REDIS_URL=redis://:generate_strong_redis_auth_token_here@redis:6379

# Security, Encryption & Tokens
JWT_SECRET=super_secret_jwt_hmac_sha256_signing_key_min_64_chars
ENCRYPTION_KEY_32BYTES=generate_32_byte_aes_gcm_hex_key_here

# LLM & Reasoning Engines (Dual Jurist Protocol)
OPENAI_API_KEY=sk-proj-your-production-openai-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-production-anthropic-key-here

# Public Domain Endpoints (Configured with SSL in Nginx)
NEXT_PUBLIC_APP_URL=https://amal.app
NEXT_PUBLIC_API_URL=https://api.amal.app/api/v1
NEXT_PUBLIC_SCHOLAR_URL=https://scholar.amal.app

# Audio CDN & Streaming Providers
QURAN_AUDIO_CDN_BASE=https://everyayah.com/data
SHAMAIL_AUDIO_CDN_BASE=https://audio.amal.app/shamail

# Observability, Tracing & Error Telemetry
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
